{
  "_comment": "Laya 的题面配置（唯一真相源）。改量表只改这里，不改代码。score 型问题的 criteria 数组顺序 = 分值顺序，所以能反推出原始分。",
  "scales": {
    "nihss_15": {
      "title": "NIHSS 卒中量表（15 项）",
      "instructions_prefix": "以下是一份住院患者的神经系统查体记录。请逐项判断该患者在该项上的实际得分档位。严格只依据记录中明确写到的内容：若记录中未提及该项、或该项被描述为正常，一律选择 0 分档，不得根据主诉、病情或其他项目推断。只有当记录中明确写出该项的异常表现时，才选择非 0 档。",
      "item_instructions_suffix": "请选择最符合记录原文描述的一档；若记录中没有该项的描述，选 0 分档。",
      "items": [
        {
          "key": "1a_意识水平",
          "label": "1a 意识水平",
          "instructions": "患者意识水平如何？",
          "criteria": [
            "清醒，反应灵敏",
            "嗜睡，能被最小刺激唤醒",
            "昏睡，需反复刺激或疼痛刺激才有反应",
            "昏迷，仅有反射性活动或完全无反应"
          ]
        },
        {
          "key": "1b_意识水平提问",
          "label": "1b 意识水平提问（月份、年龄）",
          "instructions": "对月份和年龄的提问，回答正确情况如何？",
          "criteria": [
            "两项均回答正确",
            "一项回答正确",
            "两项均不正确"
          ]
        },
        {
          "key": "1c_意识水平指令",
          "label": "1c 意识水平指令（睁闭眼、握拳松拳）",
          "instructions": "对睁闭眼、健侧握拳松拳的指令执行情况如何？",
          "criteria": [
            "两项均正确执行",
            "一项正确执行",
            "两项均不能执行"
          ]
        },
        {
          "key": "2_凝视",
          "label": "2 最佳凝视（眼球运动）",
          "instructions": "眼球水平运动情况如何？",
          "criteria": [
            "眼球运动正常",
            "部分凝视麻痹，但无强制性偏斜",
            "强迫性凝视麻痹或完全凝视麻痹"
          ]
        },
        {
          "key": "3_视野",
          "label": "3 视野",
          "instructions": "视野检查结果如何？",
          "criteria": [
            "视野无缺失",
            "部分偏盲",
            "完全偏盲",
            "双侧偏盲"
          ]
        },
        {
          "key": "4_面瘫",
          "label": "4 面瘫",
          "instructions": "面部运动情况如何？",
          "criteria": [
            "面部运动正常、对称",
            "轻度面瘫（鼻唇沟变浅、微笑不对称）",
            "部分面瘫（下面部完全或几乎完全瘫痪）",
            "完全面瘫（上、下面部均无运动）"
          ]
        },
        {
          "key": "5_上肢运动",
          "label": "5 上肢运动（取最差侧）",
          "instructions": "上肢肌力和运动情况如何？（取症状较重的一侧）",
          "criteria": [
            "上肢能坚持抬起 10 秒不下落",
            "抬起后 10 秒内下落但未落至床面",
            "有对抗重力的努力但肢体很快下落",
            "肢体无对抗重力的运动",
            "肢体完全不能动"
          ]
        },
        {
          "key": "6_下肢运动",
          "label": "6 下肢运动（取最差侧）",
          "instructions": "下肢肌力和运动情况如何？（取症状较重的一侧）",
          "criteria": [
            "下肢能坚持抬起 5 秒不下落",
            "抬起后 5 秒内下落但未落至床面",
            "有对抗重力的努力但腿很快下落",
            "肢体无对抗重力的运动",
            "肢体完全不能动"
          ]
        },
        {
          "key": "7_肢体共济失调",
          "label": "7 肢体共济失调",
          "instructions": "指鼻试验、跟膝胫试验的共济失调表现如何？",
          "criteria": [
            "无共济失调",
            "一个肢体存在共济失调",
            "两个或以上肢体存在共济失调"
          ]
        },
        {
          "key": "8_感觉",
          "label": "8 感觉（针刺觉）",
          "instructions": "针刺觉检查结果如何？",
          "criteria": [
            "感觉正常",
            "轻到中度的感觉丧失",
            "重度的感觉丧失或完全丧失"
          ]
        },
        {
          "key": "9_语言",
          "label": "9 最佳语言",
          "instructions": "语言功能和命名、复述情况如何？",
          "criteria": [
            "语言正常、无失语",
            "轻到中度失语，但表达无明显受限",
            "重度失语，交流困难",
            "缄默或完全性失语，无言语或仅有刻板语言"
          ]
        },
        {
          "key": "10_构音障碍",
          "label": "10 构音障碍",
          "instructions": "言语清晰度如何？",
          "criteria": [
            "发音清晰、正常",
            "轻到中度构音障碍，能被听懂",
            "重度构音障碍，不能被听懂，或缄默"
          ]
        },
        {
          "key": "11_忽视",
          "label": "11 忽视症",
          "instructions": "对双侧同时刺激的忽视表现如何？",
          "criteria": [
            "无忽视",
            "轻到中度忽视（一种感觉模态受累）",
            "重度忽视（一种以上感觉模态受累）"
          ]
        }
      ]
    }
  },
  "record_classify": {
    "title": "病历自动识别（Laya 快判）",
    "note": "每个问题都是低基数（<=20 选项），正好在 Laya 的能力区间；超过 20 个选项时 Laya 的 token 预算会摊薄标签，准确率明显下降，那种任务必须交 Qwen。",
    "questions": {
      "病案类型": {
        "type": "choice",
        "instructions": "这份文书属于哪一类？",
        "criteria": {
