          "神经外科": "开颅、颅内血肿清除、去骨瓣、动脉瘤夹闭",
          "急诊科": "急诊留观、抢救室",
          "心血管内科": "冠心病、心衰、心律失常",
          "康复科": "康复评定、功能训练",
          "其他": "以上都不是"
        }
      },
      "卒中相关": {
        "type": "noul",
        "instructions": "病历中是否出现明确的脑卒中（脑梗死/脑出血/缺血性卒中/TIA）诊断或描述？",
        "criteria": {
          "false": "没有卒中相关诊断或描述",
          "true": "有明确的卒中诊断或描述"
        },
        "labels": {
          "false": "否",
          "true": "是"
        }
      },
      "溶栓相关": {
        "type": "noul",
        "instructions": "病历中是否提到静脉溶栓（rt-PA/阿替普酶/替奈普酶）或取栓治疗？",
        "criteria": {
          "false": "未提及",
          "true": "提及溶栓或取栓"
        },
        "labels": {
          "false": "否",
          "true": "是"
        }
      },
      "含否定表述": {
        "type": "noul",
        "instructions": "文中是否出现对疾病或症状的明确否定表述（如「否认高血压」「无发热」「未见异常」）？",
        "criteria": {
          "false": "没有否定表述",
          "true": "有否定表述"
        },
        "labels": {
          "false": "否",
          "true": "是"
        }
      },
      "文书完整度": {
        "type": "score",
        "instructions": "这份文书的可提取信息完整度如何？",
        "criteria": [
          "信息严重缺失，几乎无法提取",
          "缺失较多，只能提取少量字段",
          "基本完整，主要字段可提取",
          "完整，几乎所有字段可提取"
        ]
      }
