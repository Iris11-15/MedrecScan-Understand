          "会诊记录": "会诊申请或会诊意见",
          "检验检查报告": "化验单、影像报告",
          "病案首页": "住院病案首页",
          "护理记录": "护理记录单、评估单",
          "其他": "以上都不是"
        }
      },
      "科室": {
