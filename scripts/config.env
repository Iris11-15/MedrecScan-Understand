# =====================================================================
#  config.env — 新架构的唯一配置文件（所有脚本都 source 它）
#  目标机：Ubuntu 22.04 + 4× RTX 4090（Ada sm_89）
#  形态：OCR 前端识别 + Qwen3.8-27B 后端（Q4/AWQ）+ Laya 打分前端
# =====================================================================
#  改这一个文件，不要改脚本里的硬编码。
# =====================================================================

# ---------- 1. 路径 ----------
export MEDREC_ROOT="${MEDREC_ROOT:-$HOME/medrec}"
export MEDREC_SRC="$MEDREC_ROOT/src"
export MEDREC_MODELS="$MEDREC_ROOT/models"
export MEDREC_JOBS="$MEDREC_ROOT/jobs"
export MEDREC_LOGS="$MEDREC_ROOT/logs"
export MEDREC_SCRIPTS="$MEDREC_ROOT/scripts"
export MEDREC_RUN="$MEDREC_ROOT/run"          # pid 文件
export MEDREC_BACKUP="$MEDREC_ROOT/backup"

# ---------- 2. conda（绝对路径，绝不用裸 python/pip） ----------
#  这台机器 PATH 里 /home/ubuntu/fsl/bin 排在 conda 前面，裸 python 会解析到 FSL 的 Python。
export CONDA_BASE="${CONDA_BASE:-$HOME/anaconda3}"
export ENV_OCR="$CONDA_BASE/envs/ocr-env"       # PaddleX + 快路径（paddle）
export ENV_LLM="$CONDA_BASE/envs/qwen-env"      # vLLM 0.30+ / transformers>=5.8
export ENV_LAYAD="$CONDA_BASE/envs/laya-env"    # 决策模型（torch 2.14 / transformers 5.x）
export PY_OCR="$ENV_OCR/bin/python"
export PY_LLM="$ENV_LLM/bin/python"
export PY_LAYAD="$ENV_LAYAD/bin/python"

# ---------- 3. 四张卡怎么分 ----------
#  设计原则：**别让独立服务共卡**。gpu-memory-utilization 是占总量的比例，
#  且不感知同卡其他服务 —— 共卡时 vLLM 照样按 24564 算预算，于是权重装完就没 KV。
#
#  ⚠ Qwen 是 TP=2，gpu-memory-utilization 会在卡组里**每张卡都按同一个比例预申请**。
#    所以 TP 卡组里不能有别的服务，否则合计直接超订（例如 0.80+0.20=1.00 → 零余量，必挂）。
#
#  GPU0 : PaddleX 版面 + PP-OCRv5 快路径（约 1.5GB）
#  GPU1 : PaddleOCR-VL-1.6（0.9B，单卡；约 4.9GB）
#  GPU2 : Qwen3.8-27B TP 第 1 片
#  GPU3 : Qwen3.8-27B TP 第 2 片
#
#  为什么 VL 不放 GPU2/3：它和 Qwen 的 TP 卡组共卡时，Qwen 的 GMU 必须在两张卡上
#  都成立，而 VL 那 0.20 会让被共用的那张卡超订。VL 只有 0.9B，单独放 GPU1 最省事。
export GPU_OCR_PADDLE=0         # PaddleX 用哪张卡（脚本内部固定传 --device gpu:0）
export GPU_VL_TP="0"     # 与 PaddleX/Laya 共卡 GPU0（三项合计约 8GB）
export GPU_QWEN_TP="2,3"        # Qwen 的 TP 卡组（与任何其他服务隔离）
export GPU_LAYAD=0        # 与 VL 共卡 GPU0（约 1.5GB）

# ---------- 4. 端口 ----------
export PORT_OCR_PADDLE=8100     # PaddleX 产线 /layout-parsing
export PORT_OCR_VL=8110         # PaddleOCR-VL 权重（vLLM，OpenAI 兼容）
export PORT_QWEN=8080           # 2026-10-07：vLLM :8102 已停 → Strata :8080（OpenAI 兼容）
export PORT_LAYAD=8111          # Laya 打分微服务（本仓库 laya_service.py）

# ---------- 5. 模型（魔搭优先；HF 同名镜像可用时 vLLM 也能直接拉） ----------
export MODEL_OCR_PADDLE="PaddleOCR-VL-1.6"                                  # PaddleX 产线注册名，不能简写
export MODEL_OCR_VL_ID="PaddlePaddle/PaddleOCR-VL-1.6"                      # 0.9B
export MODEL_OCR_VL_NAME="PaddleOCR-VL"
export MODEL_OCR_VL_PATH="${MODEL_OCR_VL_PATH:-$MEDREC_MODELS/PaddleOCR-VL-1.6}"

# 2026-10-07：抽取大模型换代为 Strata（外部服务，不在本机 models/ 下）。
# MODEL_QWEN_ID/PATH 保留旧值 —— 那是已停的 vLLM 权重，别拿来启动。
# Strata：模型名 qwen3.8-flash-next-iq3_s，API key 任意（sk-local），
# 上下文 131072，思维链模型（message 里多 reasoning_content），默认单请求。
# 注意 f3_escalate.py 的 QWEN_MAXLEN 默认仍是 32768（实测对本例的批数/max_tokens 无影响）。
export MODEL_QWEN_ID="cyankiwi/Qwen3.8-27B-AWQ-INT4"
export MODEL_QWEN_NAME="qwen3.8-flash-next-iq3_s"
export MODEL_QWEN_PATH="$MEDREC_MODELS/Qwen3.8-27B-AWQ-INT4"

# Laya 三个检查点由 laya 包自己按需下载（HF，约 1.5GB）
export LAYA_ROUTER_MODEL="${LAYA_ROUTER_MODEL:-multilingual}"

# ---------- 6. vLLM 运行参数 ----------
#  实测：每卡 total 24564 MiB，其中约 480 MiB 是驱动/OS 基线（vLLM 拿不到，
#  但它按**总量**算 gpu-memory-utilization）→ 取值建议 0.40~0.80。
#  别顶到 0.90 以上：CUDA context / CUDA graph 的分配不在该预算内，容易在
#  图捕获阶段 OOM。要更大 KV，调 QWEN_MAXLEN 与 QWEN_MAX_SEQS，不是顶满 GMU。
export QWEN_TP=2                    # 必须整除【文本模型】的 num_attention_heads（实测 24，不是视觉塔的 16）
                                    #   → 有效值 1/2/3/4/6/8；11-start-qwen.sh 会预检并打印可选集。
                                    #   ⚠ 原注释写「16 个注意力头 → 1/2/4/8/16」是照抄官方 recipe 里
                                    #   视觉编码器的值，对文本模型是错的（TP=16 非法、TP=3 反而合法）
export QWEN_MAXLEN=32768
export QWEN_MAX_SEQS=64             # ★ 实测校正（2026-09-27）：原缺此项 → vLLM 取默认 256 → 起不来。
                                    #   本模型是 Mamba/线性注意力 + 全注意力的混合结构，
                                    #   每个 decode 序列独占一个 Mamba cache block，块数由 GMU 决定：
                                    #     GMU=0.80 → 234 块 < 默认 max_num_seqs=256 → 抛
                                    #     'max_num_seqs (256) exceeds available Mamba cache blocks (234)'
                                    #     → CUDA graph 捕获阶段退出（在 'GPU KV cache size' 之后）
                                    #   硬天花板 = 启动日志里那句 "available Mamba cache blocks (N)"。
                                    #   64 是原来稳定跑了两天的那个 27B 进程 cmdline 里的值。
                                    #   本项目 F6/arbiter 对 8102 的并发是个位数，64 远超需求。
export QWEN_GMU=0.80                # ★ 实测校正（2026-09-27）：原值 0.44 起不来。
                                    #   cyankiwi/Qwen3.8-27B-AWQ-INT4 权重共 20044 MiB，
                                    #   TP=2 → **10022 MiB/卡**；0.44 的预算只有 10808 MiB，
                                    #   减去 2155 MiB 安全垫后 KV = **−1369 MiB** →
                                    #   vLLM 必抛 'No available memory for the cache blocks'。
                                    #   0.80 的预算 19651 MiB，KV ≈ 7474 MiB/卡。
                                    #   这个值不是估的：原来稳定跑了两天的那个 27B 进程
                                    #   cmdline 里就是 --gpu-memory-utilization 0.80。
                                    #   （11-start-qwen.sh 有显存预检，改小会当场报出来）
export VL_GMU=0.20                  # 与 Qwen 共卡，只能给小值（≈4.9GB）
export VL_MAXLEN=8192
# ---------- 6.4 OCR vLLM(8110) 启动参数（round21 落地 · 2026-10-13）----------
# 10-start-ocr.sh:64 只认 OCR_VLLM_DETERMINISM 这一个钩子（脚本里 --attention-backend
#   FLASH_ATTN(:200)、--compilation-config '{"mode":0,"cudagraph_mode":"full"}'(:201)、
#   --limit-mm-per-prompt '{"image":1}'(:198) 全是硬编码，本轮无权改脚本，只能改这个变量）。
# ⚠ 缺键时脚本默认 --max-num-seqs 16，而 round19 起线上实际跑的是 64 —— 本轮把它写死，
#   顺带加上 round21 唯一胜出的旋钮 --max-num-batched-tokens 8192。
#   mnb 默认 2048（scheduler.py:42），且它同时是**视觉编码器缓存预算**
#   （scheduler.py:284-285 → 日志 "Encoder cache … budget of 2048 tokens"），
#   一页图 ≈1158 视觉 token ⇒ 2048 只装得下 ~2 张页图。
# 实测（4 stock vs 4 best 同会话交替、token 归一化）：稳态 9.87 → 9.09 s/例（−7.8%）、
#   s/1k gen 0.504 → 0.465（−7.7%）、steps/1k gen −7.9%；命中 906–907/960、
#   主诉/查体 39/40、scan_trace 逐例不变、日期非严格 0 格 —— 无字段回归。
# 回滚：删掉下面两行 → 脚本回到 mns16；或只删 --max-num-batched-tokens → 回到 round19 stock。
export OCR_VLLM_DETERMINISM="--max-num-seqs 64 --no-enable-prefix-caching --max-num-batched-tokens 8192"
export OCR_VLLM_GMU=0.7             # 单副本独占 GPU0（脚本 :54 默认也是 0.7，写死防漂移）
export QWEN_TEXT_ONLY=1             # 1=丢掉视觉塔只做纯文本（省显存；OCR 已在上游完成）
                                    # 要 Qwen 回看原图仲裁就改 0，但先单发一张图测通再上生产

# ---------- 6.5 OCR 通道与 Laya 参数 ----------
export VL_BACKEND=paddle            # paddle=A 路产线 / vllm=B 路权重
export LAYA_DEVICE=cuda             # 想完全不占卡就用 cpu（193~464ms/问）
export LAYA_PRELOAD=0               # ★ 实测校正（2026-09-27）：原值 1 起不来。
                                    #   `Router.preload()` 会把**路由里的每个检查点**都加载
                                    #   一遍（multilingual + typed-decisions），而
                                    #   `typed-decisions/model.safetensors` **不在 HF 缓存里**
                                    #   （快照不完整）→ IncompleteSnapshotError；HF 又连不上
                                    #   （代理 127.0.0.1:7897 未运行 → ConnectError 111）。
                                    #   0 = 启动不加载、按需加载：multilingual 是完整的，
                                    #   第一个请求会正常加载。原来跑了 2 天的那个进程
                                    #   cmdline 里就是 --no-preload。
                                    #   要恢复 preload，先补下那个缺的文件（需要网络）。
export LAYA_MAX_LEN=8192            # 检查点默认 1024 会截断长查体

# ---------- 7. 进程内环境变量 ----------
export HF_HOME="$MEDREC_MODELS"
export MODELSCOPE_CACHE="$MEDREC_MODELS/_ms_cache"
export HF_ENDPOINT="https://hf-mirror.com"
export PADDLE_PDX_MODEL_SOURCE="ModelScope"
export PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK="True"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
export VLLM_USE_FLASHINFER_SAMPLER=0
export OMP_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTHONIOENCODING=utf-8
unset PYTHONPATH PYTHONHOME 2>/dev/null || true

# ---------- 8. 打分口径 ----------
export LAYAD_CONF_MIN=0.70          # 低于此置信度 → 升级给 Qwen 复核
export QWEN_URL="http://127.0.0.1:$PORT_QWEN/v1"
# Strata 要 API key（任意串即可）。产线原来不发鉴权头，现在由
# f3_escalate._auth_hdr() 读这个变量；置空 = 不发头（旧 vLLM 行为）。
export QWEN_API_KEY="${QWEN_API_KEY:-sk-local}"
export LAYAD_URL="http://127.0.0.1:$PORT_LAYAD"

# ---------- 8b. 产线并发 + locate 止损（round23 落库，2026-10-13）----------
# 依据 reports/round22-total-time-20261013.md：
#   §2.1 阶梯扫 K∈{16,24,32} / CONC∈{32,64} / PCONC∈{8,16} ⇒ K 拐点在 24，
#        PCONC16 是第一个 <=5.0 s/例 的档；K32 只增排队不增墙钟收益。
#   §2.5 lane A 的「一例 locate 失控」= 全批 32.8% 的探针，止损后稳态 -19.3%（单卡）。
#   §2.6 42 臂字段级回归全过（905-907/960、主诉/查体 39/40、日期非严格 0、抢占 0）。
# 消费方：K 由 src/wide/tools/run_steps.py:196 直接读；CONC/PCONC 是
#   run_steps.py --ocr-concurrency / --probe-concurrency 的取值（跑批入口从本文件 source）。
export R15_CASE_PARALLEL=24       # K     —— 例级并行（run_steps.py:196 直接读）
export R23_OCR_CONCURRENCY=32     # CONC  —— s1 每例 OCR 请求并发
export R23_PROBE_CONCURRENCY=16   # PCONC —— locate 探针并发
# locate 失控例止损（src/wide/tools/locate_pages.py，round22 第 5 步草案落地）：
#   升级扫描只在「锚点页 ±R22_ESC_WINDOW」窗口内继续，且单例升级调用数 <= R22_ESC_MAX_CALLS。
#   两个值都 <=0 = 关闭止损（旧行为）。
export R22_ESC_WINDOW=13          # 升级扫描窗口：锚点（首页）±13 页
export R22_ESC_MAX_CALLS=24       # 单例升级扫描 OCR 调用上限

# ---------- 8c. OCR 复读 token 上限（round24 落库，2026-10-14）----------
# 依据 reports/round23-chase-3s-20261014.md：cap 4096→3072 使稳态 3.158/3.046 → 2.634/2.643 s/例
#   （-16.4% / -13.2%），卡忙 2.580/2.590 → 2.068/2.115，字段级回归全过。
# 安全性：40 例 × 4 臂 4,784 次请求里 finish_reason=stop 的最长响应 = 1815 字符，
#   3072 token 是其 1.70 倍（round24 第 3 步在 106 例全量上复核）。
# 消费方：src/wide/s1_ocr.py vllm_payload()（s1 正文页）与
#   src/wide/tools/locate_pages.py 页眉条探针。0 或未设 = 产线原值 vllm_max_tokens=4096。
export R23_OCR_MAX_TOKENS=3072    # OCR 单次响应 max_tokens 上限（0 = 不压）

# ---------- 8d. OCR 短周期复读「取消版」（round24 草案 -> round31 §9.5 落库）----------
# 依据 reports/round24-cancel-repeat-20261014.md：周期判据（P<=32、L=2600）命中即断连，
#   配对落库态 2.774/2.673（均值 2.724）-> 取消版 2.448/2.473（均值 2.461，稳态 -9.7%）、
#   卡忙 2.148/2.102（2.125）-> 1.884/1.998（1.941，-8.7%）；12 项硬回归全过、
#   跨轮字段差异 3-5/906、主诉 sha 差异 0。
# 消费方：src/wide/s1_ocr.py PeriodicWatcher / repeat_period_min_run()（s1 正文页 +
#   src/wide/tools/locate_pages.py 页眉条探针都走 ocr_image_vllm_stream）。
# 代价（round31 必须复核）：L=2600 相对 cap 3072 token（约 6143 字符）余量只有 1.10x，
#   且阈值算在 106 例语料上 => 本轮 fullaudit 臂复核 max_run 分布
#   （假阳性 = 砍掉合法响应尾巴 = 红线⑦的「少抽」，是正确性指标不是性能指标）。
export R24_REPEAT_PERIOD_MIN_RUN=2600   # L —— 周期连续重复 >= 此字符数判复读（0 = 关）
export R24_REPEAT_ABORT_PERIOD=1        # 1 = 命中即断连；不设/0 = 只记账不断连（审计臂）

# ---------- 8e. s6 宽表「按批分流」（round45-F 草案 -> 2026-10-18 人裁决落库）----------
# 依据 workspace/round45/FINAL.md §11：基线批 web-20261018-102926（N=3831）s6 每例跑一次，
#   累积墙钟 19,569.4 s = 全批 21,518 s 的 91%；分流后 319.9 s（61.2x）。
#   同夹具 N=600 配对 A/B：387.8 -> 26.1 s（14.9x）。
# 落后窗口实测（workspace/round45/perf20_lag_*.out）：宽表最多落后 48 例 / 176.5 s，
#   均值 13.6 例 / 62.0 s —— 跑批中途看宽表会看到这个滞后，收尾全量汇总后归零。
# 回归：CELLS_DIFF=0、cell_sha.json 80,723 格 md5 相同、doctor FAIL=0 WARN=7。
# 消费方：src/wide/tools/run_steps.py:273,274（闸门 s6_should_run()）。
# 红线⑦：不省任何例；收尾全量 s6_final（run_steps.py:421）照跑 => 终态宽表与节流无关。
export R45_S6_EVERY=200           # S6EV —— 攒够多少例才出一次宽表
export R45_S6_MAXAGE=120          # S6AG —— 距上次出表 >= 多少秒强制出一次（落后窗口上界）
# 回滚旧行为（每例一次）：R45_S6_EVERY=1 R45_S6_MAXAGE=0

# ---------- 9. 工具函数 ----------
medrec_log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
medrec_die() { printf '[%s] ✗ %s\n' "$(date +%H:%M:%S)" "$*" >&2; exit 1; }

# 从 PATH 剔除 fsl/freesurfer，保证子进程不会抓到错的 python
medrec_clean_path() {
  local IFS=':' p out=()
  for p in $PATH; do
    case "$p" in *fsl*|*freesurfer*) ;; *) out+=("$p") ;; esac
  done
  PATH="$(IFS=':'; echo "${out[*]}")"
  export PATH
}

medrec_mkdirs() {
  mkdir -p "$MEDREC_SRC" "$MEDREC_MODELS" "$MEDREC_JOBS" "$MEDREC_LOGS" \
           "$MEDREC_SCRIPTS" "$MEDREC_RUN" "$MEDREC_BACKUP"
}

# 等一个 OpenAI 兼容端点就绪（vLLM 首次启动要 1~3 分钟）
wait_http() {
  local url="$1" tries="${2:-120}" i=0
  while [ "$i" -lt "$tries" ]; do
    if curl -sf -m 3 "$url" >/dev/null 2>&1; then echo "  ✓ ready: $url"; return 0; fi
    i=$((i+1)); sleep 2
  done
  echo "  ✗ 超时未就绪: $url" >&2; return 1
}

# ---------- 10. 交互式 source 时的可见反馈 ----------
#  这些变量只在**脚本内部**被 source 过。你在终端直接敲 $MODEL_QWEN_PATH 会是空的
#  （会展开成 /*.safetensors 这种诡异路径）。要用就先载入这一份：
#      source ~/medrec/scripts/config.env
#  下面只在交互式 shell 打印，脚本调用时不会打扰输出。
if [ -t 1 ] && [ -n "${PS1:-}" ]; then
  printf '\n[config.env 已载入]\n'
  printf '  %-18s %s\n' 'MEDREC_ROOT'     "$MEDREC_ROOT"
  printf '  %-18s %s\n' 'MODEL_QWEN_PATH' "$MODEL_QWEN_PATH"
  printf '  %-18s %s\n' 'MODEL_OCR_VL_PATH' "$MODEL_OCR_VL_PATH"
  printf '  %-18s %s\n' 'PY_OCR'          "$PY_OCR"
  printf '  %-18s %s\n' 'PY_LLM'          "$PY_LLM"
  printf '  %-18s %s\n' 'PY_LAYAD'        "$PY_LAYAD"
  printf '  端口: OCR-A %s · OCR-B %s · Qwen %s · Laya %s\n' \
         "$PORT_OCR_PADDLE" "$PORT_OCR_VL" "$PORT_QWEN" "$PORT_LAYAD"
  printf '  状态总览: bash %s/15-check.sh --list\n' "$MEDREC_SCRIPTS"
  # 变量有值 ≠ 权重已下载 —— 这两件事最容易混
  [ -d "$MODEL_QWEN_PATH" ] \
    && printf '  ✓ Qwen 权重目录存在\n' \
    || printf '  ! 注意：%s 目录还不存在 → 先跑 02-download-models.sh qwen\n' "$MODEL_QWEN_PATH"
  printf '\n'
fi
